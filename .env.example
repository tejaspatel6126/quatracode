# Application
APP_NAME="AI-Powered Web Security Auditor"
APP_ENV=development
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-secret-key

# Server
HOST=0.0.0.0
PORT=8000

# Database (MySQL 8.x)
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/web_security_auditor
DB_HOST=localhost
DB_PORT=3306
DB_NAME=web_security_auditor
DB_USER=user
DB_PASSWORD=password
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# CORS
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Logging
LOG_LEVEL=INFO

# AI (Phase 08 — leave blank for now)
AI_ENABLED=false
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT=30
AI_MAX_TOKENS=1000
